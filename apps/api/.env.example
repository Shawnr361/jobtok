NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (web app, Expo web).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Matches docker-compose.yml (npm run db:up)
DATABASE_URL=postgresql://jobtok:jobtok@localhost:5432/jobtok
REDIS_URL=redis://localhost:6379
