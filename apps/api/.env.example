NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (web app, Expo web).
# Also the only origins allowed to use the web refresh cookie.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Proxy hops to trust for client IPs (rate limiting). 0 locally, usually 1 behind a load balancer.
TRUST_PROXY=0

# Matches docker-compose.yml (npm run db:up) and the embedded database (npm run db:embedded)
DATABASE_URL=postgresql://jobtok:jobtok@localhost:5432/jobtok
REDIS_URL=redis://localhost:6379

# Optional: run tests against this disposable database instead of the embedded one.
# TEST_DATABASE_URL=postgresql://jobtok:jobtok@localhost:5432/jobtok_test

# ─── Authentication ────────────────────────────────────────────────────────
# Secrets: at least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in development, random per-process values are used (sessions reset on restart).
# Required in production. Never commit real values.
JWT_ACCESS_SECRET=
AUTH_HASH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Web app URL used in email links (verify email, reset password).
APP_WEB_URL=http://localhost:3000

# Delivery providers. `dev` = DEVELOPMENT ONLY: messages (including OTP codes and links)
# are printed to the API console and NOT delivered. The API refuses to start in production
# with `dev`; a real provider adapter must be added first (see README).
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev

# Google Sign-In: comma-separated OAuth client IDs whose ID tokens are accepted
# (web, iOS and Android clients). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=
# DEVELOPMENT ONLY: accept fake `dev-google:<id>:<email>` tokens (not Google). Refused in production.
AUTH_DEV_GOOGLE=false
