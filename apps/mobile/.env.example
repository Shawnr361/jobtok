# Copy to .env. EXPO_PUBLIC_* values are public (bundled into the app).
# Android emulator: http://10.0.2.2:4000 — physical phone: your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client IDs (public identifiers). Leave empty to disable Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# DEVELOPMENT ONLY: show a fake Google sign-in (requires AUTH_DEV_GOOGLE=true on the API).
EXPO_PUBLIC_AUTH_DEV_GOOGLE=false
