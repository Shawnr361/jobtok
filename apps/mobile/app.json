{
  "expo": {
    "name": "JobTok",
    "slug": "jobtok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobtok.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jobtok.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jobtok",
    "backgroundColor": "#0B0D18",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "JobTok needs your videos so you can choose one to post and show what you can do.",
          "cameraPermission": "JobTok uses your camera so you can record a video of your work.",
          "microphonePermission": "JobTok uses your microphone so your videos have sound."
        }
      ]
    ]
  }
}
