# Copy to .env.local. NEXT_PUBLIC_* values are public (bundled into the browser build).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth *web* client ID (public identifier). Leave empty to disable Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# DEVELOPMENT ONLY: show a fake Google button (requires AUTH_DEV_GOOGLE=true on the API).
NEXT_PUBLIC_AUTH_DEV_GOOGLE=false
