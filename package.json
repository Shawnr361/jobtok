{
  "name": "jobtok",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@jobtok/api",
    "dev:web": "turbo run dev --filter=@jobtok/web",
    "dev:mobile": "npm run start --workspace=@jobtok/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prepare": "husky",
    "db:embedded": "npm run db:embedded -w @jobtok/api",
    "db:migrate": "npm run db:migrate -w @jobtok/api",
    "db:deploy": "npm run db:deploy -w @jobtok/api",
    "db:status": "npm run db:status -w @jobtok/api",
    "db:seed": "npm run db:seed -w @jobtok/api",
    "db:reset": "npm run db:reset -w @jobtok/api",
    "db:studio": "npm run db:studio -w @jobtok/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
